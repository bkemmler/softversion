{
  "name": "softversion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Software-Update-Tracker: prüft täglich Herstellerseiten auf neue Releases und meldet sie in Teams.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/server/main.ts & vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning src/server/main.ts",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/setup.ts --test \"test/**/*.test.ts\"",
    "lint": "tsc --noEmit",
    "check": "node --disable-warning=ExperimentalWarning src/server/cli.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "croner": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
