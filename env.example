# Kopieren nach ".env" (im selben Ordner wie compose.yaml) und Werte setzen.
# Nur Infrastruktur, keine fachliche Konfiguration.
# Pflicht: Schlüssel für die Verschlüsselung von Webhook-URLs und Passwörtern (mind. 16 Zeichen).
# Erzeugen z. B. mit: openssl rand -base64 32
# Achtung: Geht der Schlüssel verloren, müssen Teams-Kanäle und Zugangsdaten neu eingetragen werden.
APP_SECRET=
TZ=Europe/Berlin
LOG_LEVEL=info
# Optional, nur falls ein Proxy nötig ist:
# HTTP_PROXY=http://proxy:3128
# HTTPS_PROXY=http://proxy:3128
# NO_PROXY=localhost,127.0.0.1
